# ── Frontend (también se usan en el servidor) ──
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ── Solo servidor (cargar en Vercel → Settings → Environment Variables) ──
# Supabase → Project Settings → API → service_role. NUNCA con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago → Tus integraciones → Credenciales (TEST-... para pruebas, APP_USR-... producción)
MP_ACCESS_TOKEN=
# Mercado Pago → Webhooks → "Clave secreta" (opcional pero recomendado)
MP_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta for Developers → tu app → WhatsApp → Configuración de la API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=actualizacion_pedido
WHATSAPP_TEMPLATE_LANG=es_AR

# Opcional: URL pública fija (si no, se toma del dominio de la petición)
APP_URL=
